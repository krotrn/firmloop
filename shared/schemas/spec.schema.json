{
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "op": {
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "channel",
        "op",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Expectation": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "hold_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Hold Ms",
          "type": "integer"
        },
        "op": {
          "enum": [
            "eq",
            "display_contains",
            "display_contains_value",
            "display_row_eq"
          ],
          "title": "Op",
          "type": "string"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "source_channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Channel"
        },
        "tolerance": {
          "default": 0.0,
          "title": "Tolerance",
          "type": "number"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "within_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Within Ms",
          "type": "integer"
        }
      },
      "required": [
        "channel",
        "op"
      ],
      "title": "Expectation",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "description": "Optional threshold-style behaviour; enables boundary and truth-table tests.",
      "properties": {
        "combine": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Combine",
          "type": "string"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "hysteresis": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hysteresis"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "otherwise": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "boolean"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Otherwise"
        },
        "then": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Then",
          "type": "object"
        }
      },
      "required": [
        "id",
        "description",
        "conditions",
        "then"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "given": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Given",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "steps"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "at_ms": {
          "minimum": 0,
          "title": "At Ms",
          "type": "integer"
        },
        "expect": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Expectation"
          },
          "title": "Expect",
          "type": "array"
        },
        "set": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Set",
          "type": "object"
        }
      },
      "required": [
        "at_ms"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "maxItems": 10,
      "title": "Rules",
      "type": "array"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/Scenario"
      },
      "maxItems": 15,
      "minItems": 1,
      "title": "Scenarios",
      "type": "array"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "summary",
    "scenarios"
  ],
  "title": "Spec",
  "type": "object"
}
