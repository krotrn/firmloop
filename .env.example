# FirmLoop environment. Copy to .env and edit. Never commit .env.

# ---- Environment ----
# dev | test  (test enables the "fake" LLM provider for automated tests)
FIRMLOOP_ENV=dev
LOG_LEVEL=INFO

# ---- AI provider ----
# gemini | ollama | anthropic
LLM_PROVIDER=gemini
# optional provider to switch to when the main one is rate-limited/unavailable (empty = none)
LLM_FALLBACK_PROVIDER=

# Gemini (free tier key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama: host install -> http://host.docker.internal:11434 ; compose profile -> http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# host Ollama only: read by the Ollama server itself, not by FirmLoop. Bind to the docker0 IP, never 0.0.0.0
# OLLAMA_HOST=172.17.0.1:11434

# Anthropic (optional, paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# per-provider LLM call timeouts (seconds); local models on a 4 GB GPU are slow
GEMINI_TIMEOUT_S=120
ANTHROPIC_TIMEOUT_S=120
OLLAMA_TIMEOUT_S=300
# Ollama context window; the Ollama default is smaller and silently truncates prompts
OLLAMA_NUM_CTX=8192

# ---- Agent loop ----
# 1..8
MAX_ATTEMPTS=5
# true = skip confirmation for non-destructive specs (destructive diffs always ask)
AUTO_APPROVE=false
# working time per run, excluding time waiting for the user
RUN_TIMEOUT_S=2400

# ---- Device ----
# real | virtual
DEVICE_MODE=virtual
# empty = auto-detect under /dev/serial/by-id ; or an explicit path
DEVICE_PORT=
# host group id that owns serial devices (Arch: `getent group uucp | cut -d: -f3`, Debian: dialout)
SERIAL_GID=986

# ---- Internal service URLs (defaults match compose.yml) ----
RUNNER_URL=http://runner:8101
BUILDER_URL=http://builder:8102
DEVICE_URL=http://device:8103
# worker call timeouts (seconds)
NATIVE_REQUEST_TIMEOUT_S=90
BUILD_TIMEOUT_S=240

# ---- Storage ----
# hardware registry (manifests + drivers), mounted read-only in compose
HARDWARE_DIR=/repo/hardware
FIRMWARE_DIR=/repo/firmware
DATA_DIR=/data
DATABASE_URL=sqlite+aiosqlite:////data/firmloop.db

# ---- CORS / WebSocket origins allowed by the backend (comma-separated) ----
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Frontend ----
# NEXT_PUBLIC_* values are inlined into the frontend bundle at image build time (compose passes NEXT_PUBLIC_API_URL as a build arg).
# Changing them needs `make build`, not just a restart.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws
